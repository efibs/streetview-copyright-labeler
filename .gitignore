# Secrets: never commit an API key.
.env
*.key
api-key*.txt

# Run artefacts, all regenerable.
# NOTE: git has no trailing comments in .gitignore -- a comment on the same line
# becomes part of the pattern, so every note here sits on its own line.

# downloaded tiles
cache/
# tagged maps
out/
# harvest output awaiting labelling
clusters/
datasets/clusters/
# Vali-generated location sets: reproducible from vali/make_sets.py, and large.
# datasets/ itself stays tracked -- labeled.json is hand-made and irreplaceable,
# and to_label*.json is what accuracy_report.py uses to tell the unbiased rows
# from the adversarial ones.
datasets/generated/
# saved composite PNGs
composites/
# output of `cr-label label`
outputs/
*_tagged.json
*_labeled.json
# per-panorama score dumps; they go stale as the bank changes
*-report.csv

# Vali writes these next to each config it is given.
vali/*-locations.json
vali/stratum-*.json
vali/band-*
vali/probe-*
vali/scale*
vali/*-pilot*
vali/*-country-distribution.txt
vali/*-subdivision-distribution.txt
vali/download.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.venv/
